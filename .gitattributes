# Auto-detect text files and normalise line endings to LF in the repo
* text=auto
# Shell scripts must always use LF, even on Windows
*.sh text eol=lf
# Batch files must always use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
public/models/quest-island.glb filter=lfs diff=lfs merge=lfs -text
public/models/surpra mk.glb filter=lfs diff=lfs merge=lfs -text
